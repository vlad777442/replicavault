+bool BlueStore::_onode_blobs_unshared(OnodeRef& o)
+{
+  o->extent_map.fault_range(db, 0, o->onode.size);
+  for (auto& e : o->extent_map.extent_map) {
+    if (e.blob->get_blob().is_shared() || e.blob->get_shared_blob()) {
+      return false;
+    }
+  }
+  for (auto& b : o->extent_map.spanning_blob_map) {
+    if (b.second->get_blob().is_shared() || b.second->get_shared_blob()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void BlueStore::_onode_statfs(OnodeRef& o, volatile_statfs *vs)
+{
+  // Mirrors fsck_check_objects_shallow / _fsck_check_extents, so fsck's
+  // per-pool expectation and the moved delta agree: stored per logical
+  // extent; compressed, compressed_original, allocated and
+  // compressed_allocated once per blob.
+  vs->reset();
+  std::set<const Blob*> seen;
+  auto add_blob = [&](const Blob* b) {
+    if (!seen.insert(b).second) {
+      return;
+    }
+    const bluestore_blob_t& blob = b->get_blob();
+    bool compressed = blob.is_compressed();
+    if (compressed) {
+      vs->compressed() += blob.get_compressed_payload_length();
+      vs->compressed_original() += b->get_referenced_bytes();
+    }
+    for (auto& pe : blob.get_extents()) {
+      if (!pe.is_valid()) {
+        continue;
+      }
+      vs->allocated() += pe.length;
+      if (compressed) {
+        vs->compressed_allocated() += pe.length;
+      }
+    }
+  };
+  for (auto& e : o->extent_map.extent_map) {
+    vs->stored() += e.length;
+    add_blob(e.blob.get());
+  }
+  for (auto& b : o->extent_map.spanning_blob_map) {
+    add_blob(b.second.get());
+  }
+}
+
+int BlueStore::_move_to_collection(TransContext *txc,
+                                   CollectionRef& c,
+                                   CollectionRef& d,
+                                   OnodeRef& oldo,
+                                   OnodeRef& newo,
+                                   const ghobject_t& new_oid)
+{
+  dout(15) << __func__ << " " << c->cid << " " << oldo->oid << " -> "
+           << d->cid << " " << new_oid << dendl;
+  int r = 0;
+  ghobject_t old_oid = oldo->oid;
+  mempool::bluestore_cache_meta::string new_okey;
+
+  if (!d->cid.is_meta()) {
+    // Only moves into the meta collection are supported; anything else
+    // could break a collection's key-range ownership.
+    r = -EINVAL;
+    goto out;
+  }
+  if (newo && newo->exists) {
+    r = -EEXIST;
+    goto out;
+  }
+  // Prior writes to this object on this sequencer must reach the kv store
+  // before its omap is read below (as _clone does).
+  oldo->flush();
+  if (!_onode_blobs_unshared(oldo)) {
+    // Refused, not asserted: the caller must have checked
+    // can_move_to_collection() and copied instead. Nothing is changed.
+    derr << __func__ << " " << oldo->oid
+         << " references a shared blob; refusing cross-collection move"
+         << dendl;
+    r = -EXDEV;
+    goto out;
+  }
+
+  {
+    // statfs: the object's contribution leaves c's pool and enters d's
+    volatile_statfs vs;
+    _onode_statfs(oldo, &vs);
+    for (size_t i = 0; i < volatile_statfs::STATFS_LAST; ++i) {
+      txc->statfs_delta.values[i] -= vs.values[i];
+    }
+    txc->extra_pool_id = META_POOL_ID;
+    txc->extra_statfs_delta += vs;
+
+    // old onode and extent-shard keys go; shards are rewritten under the new
+    // onode key when the onode is written (as _rename)
+    txc->t->rmkey(PREFIX_OBJ, oldo->key.c_str(), oldo->key.size());
+    get_object_key(cct, new_oid, &new_okey);
+    string key;
+    for (auto &sh : oldo->extent_map.shards) {
+      generate_extent_shard_key_and_apply(oldo->key, sh.shard_info->offset, &key,
+        [&](const string& final_key) {
+          txc->t->rmkey(PREFIX_OBJ, final_key);
+        }
+      );
+      sh.dirty = true;
+    }
+
+    // omap keys embed the collection's pool (and the object's hash): read
+    // them under the old collection, rewrite them under the new one
+    vector<pair<string, bufferlist>> omap_kv;
+    string omap_prefix, old_head, old_tail;
+    bool has_omap = oldo->onode.has_omap();
+    if (has_omap) {
+      omap_prefix = oldo->get_omap_prefix();
+      oldo->get_omap_header(&old_head);
+      oldo->get_omap_tail(&old_tail);
+      KeyValueDB::Iterator it = db->get_iterator(
+        omap_prefix, 0, KeyValueDB::IteratorBounds{old_head, old_tail});
+      for (it->lower_bound(old_head); it->valid(); it->next()) {
+        if (it->key() >= old_tail) {
+          break;
+        }
+        omap_kv.emplace_back(it->key(), it->value());
+      }
+    }
+
+    // re-home in memory; newo becomes the moved onode, oldo the placeholder
+    newo = oldo;
+    c->move_onode_to(d.get(), oldo, new_oid, new_okey);
+
+    if (has_omap) {
+      // same prefix (the omap flags do not change), new pool in the key
+      ceph_assert(newo->get_omap_prefix() == omap_prefix);
+      txc->t->rm_range_keys(omap_prefix, old_head, old_tail);
+      txc->t->rmkey(omap_prefix, old_tail);
+      for (auto& [k, v] : omap_kv) {
+        string nk;
+        newo->rewrite_omap_key(k, &nk);
+        txc->t->set(omap_prefix, nk, v);
+      }
+      string new_tail;
+      bufferlist empty;
+      newo->get_omap_tail(&new_tail);
+      txc->t->set(omap_prefix, new_tail, empty);
+    }
+
+    txc->write_onode(newo);
+    // keep the placeholder pinned until commit, as _rename does
+    txc->note_modified_object(oldo);
+  }
+
+ out:
+  dout(10) << __func__ << " " << c->cid << " " << old_oid << " -> "
+           << d->cid << " " << new_oid << " = " << r << dendl;
+  return r;
+}
+
+int BlueStore::can_move_to_collection(CollectionHandle& c_,
+                                      const ghobject_t& oid,
+                                      const coll_t& dest)
+{
+  Collection *c = static_cast<Collection *>(c_.get());
+  if (!c->exists) {
+    return -ENOENT;
+  }
+  if (!dest.is_meta() || !c->cid.is_pg()) {
+    return -EXDEV;
+  }
+  std::unique_lock l(c->lock);
+  OnodeRef o = c->get_onode(oid, false);
+  if (!o || !o->exists) {
+    return -ENOENT;
+  }
+  return _onode_blobs_unshared(o) ? 0 : -EXDEV;
+}
