+void BlueStore::Collection::move_onode_to(
+  Collection *dest,
+  OnodeRef& oldo,
+  const ghobject_t& new_oid,
+  const mempool::bluestore_cache_meta::string& new_okey)
+{
+  // Same locks as split_cache: both onode-cache shards and both buffer-cache
+  // shards. They are recursive mutexes, so shards shared by the two
+  // collections are fine.
+  auto *ocache = get_onode_cache();
+  auto *ocache_dest = dest->get_onode_cache();
+  std::lock(ocache->lock, ocache_dest->lock, cache->lock, dest->cache->lock);
+  std::lock_guard l(ocache->lock, std::adopt_lock);
+  std::lock_guard l2(ocache_dest->lock, std::adopt_lock);
+  std::lock_guard l3(cache->lock, std::adopt_lock);
+  std::lock_guard l4(dest->cache->lock, std::adopt_lock);
+
+  OnodeRef o = oldo;
+  ghobject_t old_oid = o->oid;
+  ldout(store->cct, 15) << __func__ << " " << cid << " " << old_oid << " -> "
+                        << dest->cid << " " << new_oid << dendl;
+
+  auto po = onode_space.onode_map.find(old_oid);
+  ceph_assert(po != onode_space.onode_map.end());
+  ceph_assert(po->second == o);
+
+  // a non-existent onode stays at the old location, as OnodeSpace::rename
+  // does, so lookups of the old name until this txc commits see "absent"
+  OnodeRef placeholder(new Onode(this, old_oid, o->key));
+  po->second = placeholder;
+  ocache->_add(placeholder.get(), 1);
+
+  // install at the new location in dest, replacing any stale entry
+  auto pn = dest->onode_space.onode_map.find(new_oid);
+  if (pn != dest->onode_space.onode_map.end()) {
+    ocache_dest->_rm(pn->second.get());
+    dest->onode_space.onode_map.erase(pn);
+  }
+  dest->onode_space.onode_map[new_oid] = o;
+  if (o->cached) {
+    ocache->_move_pinned(ocache_dest, o.get());
+  }
+  o->c = dest;
+  o->oid = new_oid;
+  o->key = new_okey;
+
+  // re-home blobs and their cached buffers (the per-onode part of
+  // split_cache; the caller guarantees no blob is shared, so there is no
+  // SharedBlob to move)
+  auto rehome_blob = [&](Blob* b) {
+    for (auto& i : b->bc.buffer_map) {
+      if (!i.second.is_writing()) {
+        dest->cache->_move(cache, &i.second);
+      }
+    }
+    cache->rm_blob();
+    dest->cache->add_blob();
+    ceph_assert(!b->get_shared_blob());
+    b->collection = dest;
+  };
+  for (auto& e : o->extent_map.extent_map) {
+    e.blob->last_encoded_id = -1;
+  }
+  for (auto& b : o->extent_map.spanning_blob_map) {
+    b.second->last_encoded_id = -1;
+  }
+  for (auto& e : o->extent_map.extent_map) {
+    cache->rm_extent();
+    dest->cache->add_extent();
+    Blob* tb = e.blob.get();
+    if (tb->last_encoded_id == -1) {
+      rehome_blob(tb);
+      tb->last_encoded_id = 0;
+    }
+  }
+  for (auto& b : o->extent_map.spanning_blob_map) {
+    Blob* tb = b.second.get();
+    if (tb->last_encoded_id == -1) {
+      rehome_blob(tb);
+      tb->last_encoded_id = 0;
+    }
+  }
+  oldo = placeholder;
+  ocache->_trim();
+  ocache_dest->_trim();
+  dest->cache->_trim();
+}
