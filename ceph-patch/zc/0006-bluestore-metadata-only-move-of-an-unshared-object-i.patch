+// ---------------------------------------------------------------------------
+// ReplicaVault zero-copy vault: cross-collection OP_COLL_MOVE_RENAME of an
+// unshared object from a PG collection into the meta collection.
+namespace {
+
+struct RVObj {
+  ghobject_t src, dst;
+  bufferlist data;
+  map<string, bufferlist, std::less<>> attrs;
+  bufferlist omap_header;
+  map<string, bufferlist> omap;
+};
+
+const int64_t RV_POOL = 7;
+
+coll_t rv_pg_coll() {
+  return coll_t(spg_t(pg_t(0, RV_POOL), shard_id_t::NO_SHARD));
+}
+
+RVObj rv_obj(const string& name, uint32_t hash) {
+  RVObj o;
+  o.src = ghobject_t(hobject_t(sobject_t(name, CEPH_NOSNAP), "", hash, RV_POOL, ""));
+  o.dst = ghobject_t(hobject_t(sobject_t("rv1_" + name, CEPH_NOSNAP), "", hash,
+                               hobject_t::POOL_META, "replicavault"));
+  return o;
+}
+
+bufferlist rv_bytes(size_t len, int seed) {
+  bufferlist bl;
+  bufferptr bp(len);
+  for (size_t i = 0; i < len; ++i) {
+    bp.c_str()[i] = static_cast<char>((i * 131 + seed * 7 + i / 4096) & 0xff);
+  }
+  bl.append(bp);
+  return bl;
+}
+
+void rv_write(ObjectStore* store, ObjectStore::CollectionHandle& ch, RVObj& o,
+              size_t len, int seed, size_t nattrs, size_t nomap) {
+  ObjectStore::Transaction t;
+  o.data = rv_bytes(len, seed);
+  t.write(ch->cid, o.src, 0, o.data.length(), o.data);
+  for (size_t i = 0; i < nattrs; ++i) {
+    bufferlist v = rv_bytes(16 + i, seed + i);
+    o.attrs["attr" + std::to_string(i)] = v;
+  }
+  if (nattrs) {
+    t.setattrs(ch->cid, o.src, o.attrs);
+  }
+  if (nomap) {
+    o.omap_header = rv_bytes(64, seed);
+    t.omap_setheader(ch->cid, o.src, o.omap_header);
+    for (size_t i = 0; i < nomap; ++i) {
+      o.omap["key" + std::to_string(i)] = rv_bytes(24, seed + i);
+    }
+    t.omap_setkeys(ch->cid, o.src, o.omap);
+  }
+  ASSERT_EQ(0, queue_transaction(store, ch, std::move(t)));
+}
+
+void rv_check(ObjectStore* store, ObjectStore::CollectionHandle& sch,
+              ObjectStore::CollectionHandle& mch, RVObj& o) {
+  ASSERT_FALSE(store->exists(sch, o.src));
+  ASSERT_TRUE(store->exists(mch, o.dst));
+  struct stat st;
+  ASSERT_EQ(0, store->stat(mch, o.dst, &st));
+  ASSERT_EQ((uint64_t)st.st_size, (uint64_t)o.data.length());
+  bufferlist got;
+  ASSERT_EQ((int)o.data.length(), store->read(mch, o.dst, 0, o.data.length(), got));
+  ASSERT_TRUE(bl_eq(o.data, got));
+  map<string, bufferlist, std::less<>> attrs;
+  ASSERT_EQ(0, store->getattrs(mch, o.dst, attrs));
+  ASSERT_EQ(o.attrs.size(), attrs.size());
+  for (auto& [k, v] : o.attrs) {
+    ASSERT_TRUE(attrs.count(k));
+    ASSERT_TRUE(bl_eq(v, attrs[k]));
+  }
+  bufferlist hdr;
+  map<string, bufferlist> omap;
+  int r = store->omap_get(mch, o.dst, &hdr, &omap);
+  ASSERT_TRUE(r == 0 || r == -ENOENT);
+  ASSERT_TRUE(bl_eq(o.omap_header, hdr));
+  ASSERT_EQ(o.omap.size(), omap.size());
+  for (auto& [k, v] : o.omap) {
+    ASSERT_TRUE(omap.count(k));
+    ASSERT_TRUE(bl_eq(v, omap[k]));
+  }
+}
+
+struct RVStat {
+  int64_t pool_alloc, pool_stored, meta_alloc, meta_stored;
+};
+
+RVStat rv_stat(ObjectStore* store) {
+  store_statfs_t p, m;
+  bool pp;
+  EXPECT_EQ(0, store->pool_statfs(RV_POOL, &p, &pp));
+  EXPECT_EQ(0, store->pool_statfs(META_POOL_ID, &m, &pp));
+  return {(int64_t)p.allocated, (int64_t)p.data_stored,
+          (int64_t)m.allocated, (int64_t)m.data_stored};
+}
+
+} // anonymous namespace
+
+class RVMoveTest : public StoreTest {
+public:
+  coll_t pg = rv_pg_coll();
+  coll_t meta = coll_t::meta();
+  ObjectStore::CollectionHandle pch, mch;
+
+  void rv_setup() {
+    SetVal(g_conf(), "objectstore_debug_throw_on_failed_txc", "true");
+    g_conf().apply_changes(nullptr);
+    mch = store->create_new_collection(meta);
+    {
+      ObjectStore::Transaction t;
+      t.create_collection(meta, 0);
+      ASSERT_EQ(0, queue_transaction(store, mch, std::move(t)));
+    }
+    pch = store->create_new_collection(pg);
+    {
+      ObjectStore::Transaction t;
+      t.create_collection(pg, 0);
+      ASSERT_EQ(0, queue_transaction(store, pch, std::move(t)));
+    }
+  }
+  // move each object in one transaction on the PG collection's sequencer
+  void rv_move(vector<RVObj*> objs, bool and_remove_src = false) {
+    for (auto o : objs) {
+      ASSERT_EQ(0, store->can_move_to_collection(pch, o->src, meta));
+    }
+    ObjectStore::Transaction t;
+    for (auto o : objs) {
+      t.collection_move_rename(pg, o->src, meta, o->dst);
+      if (and_remove_src) {
+        // as the PG transaction will: remove after the move (ENOENT is fine)
+        t.remove(pg, o->src);
+      }
+    }
+    ASSERT_EQ(0, queue_transaction(store, pch, std::move(t)));
+  }
+  void rv_remount_fsck_check(vector<RVObj*> objs) {
+    for (auto o : objs) {
+      rv_check(store.get(), pch, mch, *o);
+    }
+    pch.reset();
+    mch.reset();
+    ASSERT_EQ(0, store->umount());
+    ASSERT_EQ(0, store->fsck(true));  // deep
+    ASSERT_EQ(0, store->mount());
+    pch = store->open_collection(pg);
+    mch = store->open_collection(meta);
+    ASSERT_TRUE(pch);
+    ASSERT_TRUE(mch);
+    for (auto o : objs) {
+      rv_check(store.get(), pch, mch, *o);
+    }
+  }
+  void rv_expect_moved_stats(const RVStat& before, const RVStat& after) {
+    // what left the PG's pool is exactly what the meta pool gained
+    ASSERT_EQ(before.pool_alloc - after.pool_alloc, after.meta_alloc - before.meta_alloc);
+    ASSERT_EQ(before.pool_stored - after.pool_stored, after.meta_stored - before.meta_stored);
+    ASSERT_GE(before.pool_stored - after.pool_stored, 0);
+  }
+};
+
+TEST_P(RVMoveTest, SmallAndLarge) {
+  if (string(GetParam()) != "bluestore")
+    return;
+  rv_setup();
+  // 4 KiB (deferred path), 64 KiB, 4 MiB (direct), with xattrs and omap
+  RVObj a = rv_obj("small", 0x1111), b = rv_obj("mid", 0x2222), c = rv_obj("large", 0x3333);
+  rv_write(store.get(), pch, a, 4096, 1, 3, 5);
+  rv_write(store.get(), pch, b, 65536, 2, 3, 5);
+  rv_write(store.get(), pch, c, 4 << 20, 3, 3, 5);
+  RVStat s0 = rv_stat(store.get());
+  rv_move({&a});
+  rv_move({&b});
+  rv_move({&c}, true);
+  rv_expect_moved_stats(s0, rv_stat(store.get()));
+  rv_remount_fsck_check({&a, &b, &c});
+  rv_expect_moved_stats(s0, rv_stat(store.get()));
+}
+
+TEST_P(RVMoveTest, FragmentedShardedExtentMap) {
+  if (string(GetParam()) != "bluestore")
+    return;
+  // small shards so the extent map is sharded and blobs span shards
+  SetVal(g_conf(), "bluestore_extent_map_shard_max_size", "200");
+  SetVal(g_conf(), "bluestore_extent_map_shard_target_size", "100");
+  g_conf().apply_changes(nullptr);
+  rv_setup();
+  RVObj o = rv_obj("frag", 0x4444);
+  rv_write(store.get(), pch, o, 1 << 20, 4, 1, 0);
+  // many small overwrites at scattered offsets
+  for (int i = 0; i < 300; ++i) {
+    ObjectStore::Transaction t;
+    uint64_t off = ((uint64_t)i * 7919 * 4096) % ((1 << 20) - 4096);
+    bufferlist bl = rv_bytes(1000 + (i % 3000), 100 + i);
+    t.write(pg, o.src, off, bl.length(), bl);
+    o.data.begin(off).copy_in(bl.length(), bl.c_str());
+    ASSERT_EQ(0, queue_transaction(store, pch, std::move(t)));
+  }
+  RVStat s0 = rv_stat(store.get());
+  rv_move({&o}, true);
+  rv_expect_moved_stats(s0, rv_stat(store.get()));
+  rv_remount_fsck_check({&o});
+}
+
+TEST_P(RVMoveTest, LargeOmapAndXattrs) {
+  if (string(GetParam()) != "bluestore")
+    return;
+  rv_setup();
+  RVObj o = rv_obj("omap", 0x5555);
+  rv_write(store.get(), pch, o, 8192, 5, 50, 20000);
+  rv_move({&o}, true);
+  rv_remount_fsck_check({&o});
+}
+
+TEST_P(RVMoveTest, CompressionForced) {
+  if (string(GetParam()) != "bluestore")
+    return;
+  SetVal(g_conf(), "bluestore_compression_algorithm", "snappy");
+  SetVal(g_conf(), "bluestore_compression_mode", "force");
+  g_conf().apply_changes(nullptr);
+  rv_setup();
+  // compressible data
+  RVObj a = rv_obj("comp", 0x6666);
+  {
+    ObjectStore::Transaction t;
+    bufferlist bl;
+    bl.append(string(2 << 20, 'z'));
+    a.data = bl;
+    t.write(pg, a.src, 0, bl.length(), bl);
+    ASSERT_EQ(0, queue_transaction(store, pch, std::move(t)));
+  }
+  store_statfs_t p0, m0, p1, m1;
+  bool pp;
+  ASSERT_EQ(0, store->pool_statfs(RV_POOL, &p0, &pp));
+  ASSERT_EQ(0, store->pool_statfs(META_POOL_ID, &m0, &pp));
+  // the write must actually have been compressed for this test to mean anything
+  ASSERT_GT(p0.data_compressed_original, 0u);
+  RVStat s0 = rv_stat(store.get());
+  rv_move({&a}, true);
+  rv_expect_moved_stats(s0, rv_stat(store.get()));
+  rv_remount_fsck_check({&a});
+  ASSERT_EQ(0, store->pool_statfs(RV_POOL, &p1, &pp));
+  ASSERT_EQ(0, store->pool_statfs(META_POOL_ID, &m1, &pp));
+  // compressed accounting moved with the object
+  ASSERT_EQ(p0.data_compressed_original - p1.data_compressed_original,
+            m1.data_compressed_original - m0.data_compressed_original);
+  ASSERT_EQ(p0.data_compressed - p1.data_compressed,
+            m1.data_compressed - m0.data_compressed);
+  ASSERT_EQ(p0.data_compressed_allocated - p1.data_compressed_allocated,
+            m1.data_compressed_allocated - m0.data_compressed_allocated);
+  ASSERT_GT(m1.data_compressed_original, 0u);
+}
+
+TEST_P(RVMoveTest, MoveQueuedAfterUncommittedWrite) {
+  if (string(GetParam()) != "bluestore")
+    return;
+  rv_setup();
+  for (int k = 0; k < 20; ++k) {
+    RVObj o = rv_obj("raq" + std::to_string(k), 0x7000 + k);
+    rv_write(store.get(), pch, o, 4096 * (1 + k % 4), 10 + k, 1, 2);
+    // overwrite and move queued back to back without waiting for the write
+    ObjectStore::Transaction t1, t2;
+    bufferlist bl = rv_bytes(o.data.length(), 1000 + k);
+    t1.write(pg, o.src, 0, bl.length(), bl);
+    t1.omap_setkeys(pg, o.src, map<string, bufferlist>{{"late", bl}});
+    o.data = bl;
+    o.omap["late"] = bl;
+    ASSERT_EQ(0, store->queue_transaction(pch, std::move(t1)));
+    t2.collection_move_rename(pg, o.src, meta, o.dst);
+    t2.remove(pg, o.src);
+    ASSERT_EQ(0, queue_transaction(store, pch, std::move(t2)));
+    rv_check(store.get(), pch, mch, o);
+  }
+  pch.reset();
+  mch.reset();
+  ASSERT_EQ(0, store->umount());
+  ASSERT_EQ(0, store->fsck(true));
+  ASSERT_EQ(0, store->mount());
+}
+
+TEST_P(RVMoveTest, ManyMovesThenRemoveSourceCollection) {
+  if (string(GetParam()) != "bluestore")
+    return;
+  rv_setup();
+  vector<RVObj> objs;
+  for (int i = 0; i < 50; ++i) {
+    objs.push_back(rv_obj("many" + std::to_string(i), 0x8000 + i * 97));
+  }
+  for (int i = 0; i < 50; ++i) {
+    rv_write(store.get(), pch, objs[i], 4096 * (1 + i % 8), 200 + i, 2, 3);
+  }
+  vector<RVObj*> ptrs;
+  for (auto& o : objs) {
+    ptrs.push_back(&o);
+  }
+  RVStat s0 = rv_stat(store.get());
+  rv_move(ptrs, true);
+  rv_expect_moved_stats(s0, rv_stat(store.get()));
+  {
+    ObjectStore::Transaction t;
+    t.remove_collection(pg);
+    ASSERT_EQ(0, queue_transaction(store, pch, std::move(t)));
+  }
+  for (auto& o : objs) {
+    ASSERT_TRUE(store->exists(mch, o.dst));
+  }
+  pch.reset();
+  mch.reset();
+  ASSERT_EQ(0, store->umount());
+  ASSERT_EQ(0, store->fsck(true));
+  ASSERT_EQ(0, store->mount());
+  mch = store->open_collection(meta);
+  for (auto& o : objs) {
+    struct stat st;
+    ASSERT_EQ(0, store->stat(mch, o.dst, &st));
+    bufferlist got;
+    ASSERT_EQ((int)o.data.length(), store->read(mch, o.dst, 0, o.data.length(), got));
+    ASSERT_TRUE(bl_eq(o.data, got));
+  }
+}
+
+TEST_P(RVMoveTest, SharedBlobRefused) {
+  if (string(GetParam()) != "bluestore")
+    return;
+  rv_setup();
+  RVObj o = rv_obj("shared", 0x9999);
+  rv_write(store.get(), pch, o, 1 << 20, 9, 1, 3);
+  ghobject_t clone = o.src;
+  clone.hobj.snap = 1;
+  {
+    ObjectStore::Transaction t;
+    t.clone(pg, o.src, clone);
+    ASSERT_EQ(0, queue_transaction(store, pch, std::move(t)));
+  }
+  ASSERT_EQ(-EXDEV, store->can_move_to_collection(pch, o.src, meta));
+  // a move issued anyway is refused inside the transaction and changes nothing
+  {
+    ObjectStore::Transaction t;
+    t.collection_move_rename(pg, o.src, meta, o.dst);
+    ASSERT_EQ(0, queue_transaction(store, pch, std::move(t)));
+  }
+  ASSERT_TRUE(store->exists(pch, o.src));
+  ASSERT_TRUE(store->exists(pch, clone));
+  ASSERT_FALSE(store->exists(mch, o.dst));
+  bufferlist a, b;
+  ASSERT_EQ((int)o.data.length(), store->read(pch, o.src, 0, o.data.length(), a));
+  ASSERT_EQ((int)o.data.length(), store->read(pch, clone, 0, o.data.length(), b));
+  ASSERT_TRUE(bl_eq(o.data, a));
+  ASSERT_TRUE(bl_eq(o.data, b));
+  pch.reset();
+  mch.reset();
+  ASSERT_EQ(0, store->umount());
+  ASSERT_EQ(0, store->fsck(true));
+  ASSERT_EQ(0, store->mount());
+}
