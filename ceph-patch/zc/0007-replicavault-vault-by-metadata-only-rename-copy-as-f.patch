+/// How a vault entry was staged.
+enum class Mode { RENAME, COPY };
+
+/// Where vault ops are staged. A copy writes new data into the meta pool,
+/// so it goes in its own transaction (`copy_t`), queued on the PG's sequencer
+/// before the PG transaction: one txc carries one pool's statfs delta
+/// besides a move's. A rename takes the object away, so it must commit
+/// atomically with the PG log entry: `move_t` goes into the same
+/// queue_transactions call as the PG transaction, ahead of it.
+struct Staging {
+  ObjectStore::Transaction *copy_t;
+  ObjectStore::Transaction *move_t;
+};
