+# ReplicaVault vault mode: "rename" (move the onode into the meta collection,
+# copying only objects with shared blobs) or "copy" (always copy).
+set(RV_VAULT_MODE "rename" CACHE STRING "ReplicaVault vault mode: rename or copy")
+set_property(CACHE RV_VAULT_MODE PROPERTY STRINGS rename copy)
+if(RV_VAULT_MODE STREQUAL "copy")
