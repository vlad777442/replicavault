+bool remove_is_first_use(ObjectStore::Transaction &t, const coll_t &coll,
+			 const hobject_t &hoid)
+{
+  auto is_head = [&](const coll_t &cid, const ghobject_t &g) {
+    return cid == coll && g.is_no_gen() && g.hobj == hoid;
+  };
+  using T = ObjectStore::Transaction;
+  for (auto i = t.begin(); i.have_op(); ) {
+    T::Op *op = i.decode_op();
+    switch (op->op) {
+    case T::OP_CREATE: case T::OP_TOUCH: case T::OP_WRITE: case T::OP_ZERO:
+    case T::OP_TRUNCATE: case T::OP_REMOVE: case T::OP_SETATTR:
+    case T::OP_SETATTRS: case T::OP_RMATTR: case T::OP_RMATTRS:
+    case T::OP_CLONE: case T::OP_CLONERANGE: case T::OP_CLONERANGE2:
+    case T::OP_COLL_ADD: case T::OP_COLL_REMOVE: case T::OP_OMAP_CLEAR:
+    case T::OP_OMAP_SETKEYS: case T::OP_OMAP_RMKEYS: case T::OP_OMAP_SETHEADER:
+    case T::OP_OMAP_RMKEYRANGE: case T::OP_SETALLOCHINT:
+    case T::OP_COLL_MOVE_RENAME: case T::OP_TRY_RENAME:
+      break;
+    default:
+      continue;  // no object operand
+    }
+    const coll_t &cid = i.get_cid(op->cid);
+    if (is_head(cid, i.get_oid(op->oid))) {
+      return op->op == T::OP_REMOVE;
+    }
+    switch (op->op) {
+    case T::OP_CLONE:
+    case T::OP_CLONERANGE:
+    case T::OP_CLONERANGE2:
+    case T::OP_TRY_RENAME:
+      if (is_head(cid, i.get_oid(op->dest_oid))) {
+	return false;
+      }
+      break;
+    case T::OP_COLL_MOVE_RENAME:
+      if (is_head(i.get_cid(op->dest_cid), i.get_oid(op->dest_oid))) {
+	return false;
+      }
+      break;
+    default:
+      break;
+    }
+  }
+  return false;
+}
