+    COMPILE_DEFINITIONS RV_VAULT_MODE_COPY)
+elseif(NOT RV_VAULT_MODE STREQUAL "rename")
+  message(FATAL_ERROR "RV_VAULT_MODE must be rename or copy, not ${RV_VAULT_MODE}")
+endif()
