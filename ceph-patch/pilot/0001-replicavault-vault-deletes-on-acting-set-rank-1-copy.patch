 #include "osd_tracer.h"
+#include "ReplicaVault.h"
 
 #define dout_context cct
 #define dout_subsys ceph_subsys_osd
@@ -1117,6 +1118,31 @@ void ReplicatedBackend::do_repop(OpRequestRef op)
   decode(log, p);
   rm->opt.set_fadvise_flag(CEPH_OSD_OP_FLAG_FADVISE_DONTNEED);
 
+  // ReplicaVault: if this OSD holds the retaining rank, copy every head this
+  // transaction deletes into the vault, in this OSD's local transaction only.
+  // The shipped transaction and the log entries are not modified.
+  ObjectStore::Transaction vault_t;
+  if (!rm->opt.empty()) {
+    vector<int> acting;
+    int rank = replicavault::acting_rank(
+      *get_osdmap(), get_info().pgid.pgid, get_parent()->whoami_shard().osd,
+      &acting);
+    if (rank == replicavault::RETAIN_RANK) {
+      for (auto &hoid : replicavault::deleted_heads(rm->opt, coll, log)) {
+	eversion_t v = m->version;
+	for (auto &e : log) {
+	  if (e.soid == hoid) {
+	    v = e.version;
+	  }
+	}
+	replicavault::vault_object(
+	  cct, store, ch, get_info().pgid, hoid, v,
+	  get_parent()->whoami_shard().osd, acting,
+	  replicavault::Path::REPOP, &vault_t);
+      }
+    }
+  }
+
   bool update_snaps = false;
   if (!rm->opt.empty()) {
     // If the opt is non-empty, we infer we are before
@@ -1154,7 +1180,12 @@ void ReplicatedBackend::do_repop(OpRequestRef op)
     parent->bless_context(
       new C_OSD_RepModifyCommit(this, rm)));
   vector<ObjectStore::Transaction> tls;
-  tls.reserve(2);
+  tls.reserve(3);
+  if (!vault_t.empty()) {
+    // same BlueStore txc as the remove below: vault copy and remove commit
+    // atomically
+    tls.push_back(std::move(vault_t));
+  }
   tls.push_back(std::move(rm->localt));
   tls.push_back(std::move(rm->opt));
   parent->queue_transactions(tls, op);
