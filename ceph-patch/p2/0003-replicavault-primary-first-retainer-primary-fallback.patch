 namespace replicavault {
 
-/// The acting-set rank that retains deleted objects (0 = primary).
+/// The rank that retains deleted objects, counted in the acting set reordered
+/// primary-first (0 = the primary). Without primary_temp this is the plain
+/// acting-set rank; with primary_temp it skips the primary wherever it sits.
 constexpr int RETAIN_RANK = 1;
 
 /// Debug level (subsys osd) for the "replicavault: vaulted ..." lines.
@@ -33,13 +35,17 @@ constexpr int VAULT_LOG_LEVEL = 1;
 /// Namespace of vault entries inside coll_t::meta().
