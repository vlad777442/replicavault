+enum class Path { REPOP, RECOVERY, FALLBACK };
 
-/// Position of `osd` in the acting set of `pgid` in `osdmap`, or -1.
-/// `acting` receives the ordered acting set.
-int acting_rank(const OSDMap &osdmap, pg_t pgid, int osd,
