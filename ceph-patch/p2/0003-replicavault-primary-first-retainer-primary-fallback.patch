+/// The OSD that retains deletes for `pgid` in `osdmap`: element RETAIN_RANK
+/// of the acting set reordered primary-first, or the primary itself when the
+/// acting set has no other member (size 1, or all replicas down with
+/// min_size 1). Every OSD computes the same answer from the same map.
+/// `acting` receives the acting set as the osdmap gives it.
+int retainer_osd(const OSDMap &osdmap, pg_t pgid, std::vector<int> *acting);
 
 /// Head objects of collection `coll` that transaction `t` deletes, as
 /// opposed to overwrites:
@@ -61,4 +67,15 @@ int vault_object(CephContext *cct, ObjectStore *store,
 		 const std::vector<int> &acting, Path path,
 		 ObjectStore::Transaction *vt);
 
+/// For every head that transaction `t` deletes (deleted_heads), stage a vault
+/// copy into `vt` (vault_object). The version recorded is the head's log entry
+/// version, or `default_v` if the log has none. Returns the number staged.
+int vault_deleted_heads(CephContext *cct, ObjectStore *store,
+			ObjectStore::CollectionHandle &ch, const coll_t &coll,
+			spg_t pgid, ObjectStore::Transaction &t,
+			const std::vector<pg_log_entry_t> &log,
+			eversion_t default_v, int whoami,
+			const std::vector<int> &acting, Path path,
+			ObjectStore::Transaction *vt);
+
 } // namespace replicavault
