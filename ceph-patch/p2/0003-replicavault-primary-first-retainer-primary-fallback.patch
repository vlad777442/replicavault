diff --git a/src/osd/ReplicaVault.cc b/src/osd/ReplicaVault.cc
index 4b19ac3..bb2202a 100644
--- a/src/osd/ReplicaVault.cc
+++ b/src/osd/ReplicaVault.cc
@@ -53,22 +53,30 @@ string vault_name(spg_t pgid, const hobject_t &soid, eversion_t version,
 
 string path_str(Path p)
 {
-  return p == Path::REPOP ? "repop" : "recovery";
+  switch (p) {
+  case Path::REPOP: return "repop";
+  case Path::RECOVERY: return "recovery";
+  case Path::FALLBACK: return "fallback";
+  }
+  return "unknown";
 }
 
 } // anonymous namespace
 
-int acting_rank(const OSDMap &osdmap, pg_t pgid, int osd, vector<int> *acting)
+int retainer_osd(const OSDMap &osdmap, pg_t pgid, vector<int> *acting)
 {
   vector<int> up;
   int up_primary, acting_primary;
   osdmap.pg_to_up_acting_osds(pgid, &up, &up_primary, acting, &acting_primary);
-  for (unsigned i = 0; i < acting->size(); ++i) {
-    if ((*acting)[i] == osd) {
-      return i;
+  // primary_temp can put the primary anywhere in the acting set
+  // (OSDMap::_get_temp_osds); count ranks as if it were first.
+  vector<int> order{acting_primary};
+  for (int o : *acting) {
+    if (o != acting_primary && o != CRUSH_ITEM_NONE) {
+      order.push_back(o);
     }
   }
-  return -1;
+  return order.size() > RETAIN_RANK ? order[RETAIN_RANK] : acting_primary;
 }
 
 set<hobject_t> deleted_heads(ObjectStore::Transaction &t, const coll_t &coll,
@@ -267,4 +275,27 @@ int vault_object(CephContext *cct, ObjectStore *store,
   return 0;
 }
 
+int vault_deleted_heads(CephContext *cct, ObjectStore *store,
+			ObjectStore::CollectionHandle &ch, const coll_t &coll,
+			spg_t pgid, ObjectStore::Transaction &t,
+			const vector<pg_log_entry_t> &log, eversion_t default_v,
+			int whoami, const vector<int> &acting, Path path,
+			ObjectStore::Transaction *vt)
+{
+  int staged = 0;
+  for (auto &hoid : deleted_heads(t, coll, log)) {
+    eversion_t v = default_v;
+    for (auto &e : log) {
+      if (e.soid == hoid) {
+	v = e.version;
+      }
+    }
+    if (vault_object(cct, store, ch, pgid, hoid, v, whoami, acting, path,
+		     vt) == 0) {
+      ++staged;
+    }
+  }
+  return staged;
+}
+
 } // namespace replicavault
